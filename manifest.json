{
  "manifest_version": 3,
  "name": "Cartmates",
  "version": "0.1.0",
  "description": "Shop together, save together. Live parties with presence and chat, and a shared wishlist.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_title": "Cartmates"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": "",
  "web_accessible_resources": [
    {
      "resources": [
        "confirmed/confirmed.html",
        "confirmed/confirmed.css",
        "confirmed/confirmed.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
